{
  "profileType": "^[^:]+:wall:nanoseconds:",
  "operations": {
    "GET /aws-sdk-call": {
      "functions": ["\\.awssdkCall$"],
      "absentFunctions": ["\\.httpCall$"]
    },
    "GET /outgoing-http-call": {
      "functions": ["\\.httpCall$"],
      "absentFunctions": ["\\.awssdkCall$"]
    }
  }
}
